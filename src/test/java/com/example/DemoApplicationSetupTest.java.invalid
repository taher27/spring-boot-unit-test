public class DemoApplicationSetupTest {
    private ToDoRepository toDoRepository;
    private Logger logger;
    @BeforeEach
    public void setUp() {
        toDoRepository = Mockito.mock(ToDoRepository.class);
        logger = LoggerFactory.getLogger(DemoApplication.class);
    }
    @Test
    @Tag("integration")
    public void verifyAllToDoItemsSavedCorrectly() {
        CommandLineRunner runner = new DemoApplication().setup(toDoRepository);
        try {
            runner.run();
        } catch (Exception e) {
            e.printStackTrace();
        }
        ArgumentCaptor<ToDo> captor = ArgumentCaptor.forClass(ToDo.class);
        verify(toDoRepository, times(4)).save(captor.capture());
        assertEquals(4, captor.getAllValues().size());
    }
    @Test
    @Tag("integration")
    public void confirmLoggerOutputsCorrectInfoMessage() {
        Logger spyLogger = spy(logger);
        CommandLineRunner runner = new DemoApplication().setup(toDoRepository);
        try {
            runner.run();
        } catch (Exception e) {
            e.printStackTrace();
        }
        verify(spyLogger).info("The sample data has been generated");
    }
    @Test
    @Tag("integration")
    public void ensureRepositorySaveMethodCalledWithCorrectParameters() {
