        try {
            runner.run();
        } catch (Exception e) {
            e.printStackTrace();
        }
        verify(toDoRepository).save(new ToDo("Remove unused 
        verify(toDoRepository).save(new ToDo("Clean the code", true));
        verify(toDoRepository).save(new ToDo("Build the artifacts", false));
        verify(toDoRepository).save(new ToDo("Deploy the jar file", true));
    }
    @Test
    @Tag("integration")
    public void validateNoAdditionalToDoItemsSaved() {
        CommandLineRunner runner = new DemoApplication().setup(toDoRepository);
        try {
            runner.run();
        } catch (Exception e) {
            e.printStackTrace();
        }
        verify(toDoRepository, times(4)).save(any(ToDo.class));
